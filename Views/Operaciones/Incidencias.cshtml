@model IncidenciasViewModel
@using Microsoft.Extensions.Options
@inject IOptions<BicisApp.Services.PieHostOptions> PieHost
@{
    ViewData["Title"] = "Incidencias";
    var esSupervisor = User.IsInRole("Supervisor");
}

<div class="d-flex justify-content-between align-items-center mb-3">
<h1>Incidencias abiertas encontradas, con consulta rápida y en tiempo real</h1>
</div>

<form method="get" asp-action="Incidencias" class="card card-body mb-3">
    <div class="d-flex gap-2">
        <input type="search" name="q" value="@Model.Busqueda" class="form-control" placeholder="Buscar por estación o descripción (Algolia)" />
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Busqueda))
        {
            <a asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Busqueda))
    {
        <small class="text-muted mt-2">Resultados de Algolia para "<strong>@Model.Busqueda</strong>" (solo incidencias abiertas en la base).</small>
    }
</form>

@if (TempData["Exito"] is string exito) { <div class="alert alert-success">@exito</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

@if (Model.Origen is not null)
{
    <p class="small text-muted mb-2">Origen del listado:
        <span class="badge @(Model.Origen == "Redis" ? "bg-info text-dark" : "bg-secondary")">@Model.Origen</span>
    </p>
}

@if (!Model.Incidencias.Any())
{
    <p class="text-muted" id="sin-incidencias">No hay incidencias abiertas.</p>
}
else
{
    <table class="table table-striped align-middle" id="tabla-incidencias">
        <thead>
            <tr>
                <th>#</th>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var i in Model.Incidencias)
        {
            <tr data-id="@i.Id">
                <td>@i.Id</td>
                <td>@i.Estacion</td>
                <td>@i.Descripcion</td>
                <td>
                    <span class="badge @(i.Prioridad == PrioridadIncidencia.Alta ? "bg-danger" : i.Prioridad == PrioridadIncidencia.Media ? "bg-warning text-dark" : "bg-secondary")">@i.Prioridad</span>
                </td>
                <td><span class="badge bg-success" data-estado>@i.Estado</span></td>
                <td>
                    @if (esSupervisor)
                    {
                        <form method="post" asp-action="Cerrar" asp-route-id="@i.Id">
                            <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@* C: canal WebSocket de PieHost (solo API Key pública; el secret queda en el servidor) *@
<div id="piehost-config" hidden
     data-dominio="@PieHost.Value.Dominio"
     data-apikey="@PieHost.Value.ApiKey"
     data-canal="@PieHost.Value.Channel"></div>
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080; max-width: 380px">
    <div id="avisos-tiempo-real"></div>
    <div class="text-end"><span id="ws-estado" class="badge bg-secondary">PieHost: iniciando…</span></div>
</div>

@section Scripts {
    <script src="~/js/incidencias-tiempo-real.js" asp-append-version="true"></script>
}
