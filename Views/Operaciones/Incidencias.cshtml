@model IncidenciasViewModel
@{
    ViewData["Title"] = "Incidencias";
    var esSupervisor = User.IsInRole("Supervisor");
}

<div class="d-flex justify-content-between align-items-center mb-3">
<h1>Incidencias abiertas con consulta rápida</h1>
</div>

@if (TempData["Exito"] is string exito) { <div class="alert alert-success">@exito</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

@if (Model.Origen is not null)
{
    <p class="small text-muted mb-2">Origen del listado:
        <span class="badge @(Model.Origen == "Redis" ? "bg-info text-dark" : "bg-secondary")">@Model.Origen</span>
    </p>
}

@if (!Model.Incidencias.Any())
{
    <p class="text-muted" id="sin-incidencias">No hay incidencias abiertas.</p>
}
else
{
    <table class="table table-striped align-middle" id="tabla-incidencias">
        <thead>
            <tr>
                <th>#</th>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var i in Model.Incidencias)
        {
            <tr data-id="@i.Id">
                <td>@i.Id</td>
                <td>@i.Estacion</td>
                <td>@i.Descripcion</td>
                <td>
                    <span class="badge @(i.Prioridad == PrioridadIncidencia.Alta ? "bg-danger" : i.Prioridad == PrioridadIncidencia.Media ? "bg-warning text-dark" : "bg-secondary")">@i.Prioridad</span>
                </td>
                <td><span class="badge bg-success" data-estado>@i.Estado</span></td>
                <td>
                    @if (esSupervisor)
                    {
                        <form method="post" asp-action="Cerrar" asp-route-id="@i.Id">
                            <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
